{
	"type": "module",
	"workspaces": ["packages/*", "templates/*"],
	"scripts": {
		"dev": "bun -F './packages/*' dev",
		"watch": "bun --parallel -F './packages/*' watch",
		"prod": "bun -F './packages/*' prod",
		"typecheck": "bun -F './packages/*' typecheck",
		"lint": "bun -F './packages/*' lint",
		"test": "bun -F './packages/*' test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/bun": "^1.3.14",
		"eslint": "^10.4.1",
		"jiti": "^2.7.0",
		"tsdown": "0.22.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.0"
	}
}